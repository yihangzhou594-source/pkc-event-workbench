# Cloud mode. Keep this file local and never commit real secret values.
PKC_CLOUD=1
PKC_REMOTE=1
NODE_ENV=production
PKC_PUBLIC_URL=https://pkc-event-workbench.onrender.com

# Supabase project URL and public API key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Server-only secret. Never expose this value to browser code or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET

# Optional on first deploy. Without it the workbench still runs but OCR is disabled.
DEEPSEEK_API_KEY=
